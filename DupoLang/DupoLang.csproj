<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DupoLang</AssemblyName>
    <RootNamespace>DupoLang</RootNamespace>
    <CodePage>65001</CodePage>
    <Version>0.0.5</Version>
    <Product>Dupo Studio</Product>
    <Company>Winnigames2024</Company>
    <Authors>Winnigames2024</Authors>
    <Copyright>© 2026 Winnigames2024</Copyright>
