<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DupoBuild</AssemblyName>
    <RootNamespace>DupoBuild</RootNamespace>
    <CodePage>65001</CodePage>
    <ApplicationIcon>..\DupoStudio\Resources\dupo.ico</ApplicationIcon>
    <Version>0.0.3</Version>
    <Product>Dupo Build</Product>
    <Company>Winnigames2024</Company>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- Язык вкомпилирован внутрь: сборщик работает одним файлом. -->
  <ItemGroup>
    <Compile Include="..\DupoLang\**\*.cs"
             Exclude="..\DupoLang\bin\**\*.cs;..\DupoLang\obj\**\*.cs"
             LinkBase="DupoLang" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
