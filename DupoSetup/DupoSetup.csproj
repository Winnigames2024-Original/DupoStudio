<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DupoSetup</AssemblyName>
    <RootNamespace>DupoSetup</RootNamespace>
    <CodePage>65001</CodePage>
    <Version>0.0.6</Version>
    <Product>Dupo Studio</Product>
    <Company>Winnigames2024</Company>
    <Authors>Winnigames2024</Authors>
    <Copyright>© 2026 Winnigames2024</Copyright>
    <ApplicationIcon>..\DupoStudio\Resources\dupo.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- Язык вкомпилирован прямо в установщик: формат .dapp и дописывание
       в хвост exe берутся оттуда, и DupoLang.dll рядом не нужна. -->
  <ItemGroup>
    <Compile Include="..\DupoLang\**\*.cs"
             Exclude="..\DupoLang\bin\**\*.cs;..\DupoLang\obj\**\*.cs"
             LinkBase="DupoLang" />
  </ItemGroup>

  <ItemGroup>
    <!-- Язык вкомпилирован сюда целиком, а в нём есть Dupo.Forms —
         значит нужны те же сборки, что и окнам. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
