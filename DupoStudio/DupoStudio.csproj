<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DupoStudio</AssemblyName>
    <RootNamespace>DupoStudio</RootNamespace>
    <CodePage>65001</CodePage>
    <Version>0.0.5</Version>
    <Product>Dupo Studio</Product>
    <Company>Winnigames2024</Company>
    <Authors>Winnigames2024</Authors>
    <Copyright>© 2026 Winnigames2024</Copyright>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationIcon>Resources\dupo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DupoLang\DupoLang.csproj" />
    <ProjectReference Include="..\DupoRun\DupoRun.csproj" />
    <!-- Хост собирается раньше студии, но как ссылка на сборку не подключается:
         в нём те же типы, что в DupoLang.dll. Кладём его рядом после сборки. -->
    <ProjectReference Include="..\DupoHost\DupoHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- DupoLang.dll и DupoHost.exe уезжают ресурсами внутрь DupoStudio.exe,
       чтобы студия раздавалась одним файлом. -->
  <!-- Цепляемся к AssignTargetPaths — это самое начало работы с ресурсами.
       BeforeTargets у PrepareResources или CoreCompile не годится: MSBuild
       выполняет зависимости цели раньше, чем хуки BeforeTargets, поэтому список
       ресурсов к тому моменту уже собран и добавленное в него не попадает.
       DependsOnTargets гарантирует, что DupoLang и DupoHost уже собраны. -->
  <Target Name="EmbedRuntime"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <LangDll>..\DupoLang\bin\$(Configuration)\net48\DupoLang.dll</LangDll>
      <HostExe>..\DupoHost\bin\$(Configuration)\net48\DupoHost.exe</HostExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(LangDll)')" Text="Сначала должен собраться DupoLang: $(LangDll)" />
    <Error Condition="!Exists('$(HostExe)')" Text="Сначала должен собраться DupoHost: $(HostExe)" />
    <ItemGroup>
      <EmbeddedResource Include="$(LangDll)">
        <LogicalName>DupoStudio.Embedded.DupoLang.dll</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(HostExe)">
        <LogicalName>DupoStudio.Embedded.DupoHost.exe</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Message Importance="high" Text="Вшиваю в DupoStudio.exe: $(LangDll) и $(HostExe)" />
  </Target>

  <Target Name="CopyDupoHost" AfterTargets="Build">
    <Copy SourceFiles="..\DupoHost\bin\$(Configuration)\net48\DupoHost.exe"
          DestinationFolder="$(OutputPath)" ContinueOnError="true" />
    <Copy SourceFiles="..\DupoHost\bin\$(Configuration)\net48\DupoHost.exe.config"
          DestinationFolder="$(OutputPath)" ContinueOnError="true" />
  </Target>

</Project>
